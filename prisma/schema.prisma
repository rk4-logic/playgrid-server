// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLAYER
  OWNER
  ADMIN
}

model User {
  id       String @id @default(cuid())
  fullName String
  email    String @unique
  password String

  phone        String?
  profileImage String?

  role UserRole @default(PLAYER)

  turfs Turf[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Turf {
  id String @id @default(cuid())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name        String
  description String?

  address String
  city    String
  state   String
  pincode String

  latitude  Float?
  longitude Float?

  sports    Sport[]
  amenities Amenity[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sport {
  id String @id @default(cuid())

  name String @unique

  turfs Turf[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Amenity {
  id String @id @default(cuid())

  name String @unique

  icon String?

  turfs Turf[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
